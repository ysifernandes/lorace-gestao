# =====================================================================
# YOUTUBE AI AUTOPILOT — variáveis de ambiente
# Copie para .env (cp .env.example .env). NUNCA faça commit do .env.
# Segredos ficam só no servidor; o painel web nunca os recebe.
# =====================================================================

# --- Acesso ao painel/API -------------------------------------------
# Obrigatório para acesso fora do localhost. Gere com: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8000
# true = scheduler e worker rodam dentro do processo da API
EMBEDDED_WORKER=true

# --- Seleção de adaptadores (demo = local, sem custo, nada real) ----
LLM_PROVIDER=demo            # demo | claude
TRENDS_PROVIDER=demo         # demo | google
TTS_PROVIDER=demo            # demo | elevenlabs
VISUALS_PROVIDER=demo        # demo | pexels
PUBLISHER=dry_run            # dry_run | youtube

# --- Claude (Anthropic) ---------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high           # low | medium | high | xhigh | max
CLAUDE_ENABLE_FALLBACKS=true # fallback no servidor em caso de recusa
CLAUDE_INPUT_PRICE_PER_MTOK=4.0
CLAUDE_OUTPUT_PRICE_PER_MTOK=20.0

# --- ElevenLabs -------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_PRICE_PER_1K_CHARS=0.30

# --- Pexels (imagens licenciadas) ------------------------------------
PEXELS_API_KEY=

# --- YouTube (OAuth 2.0) ----------------------------------------------
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/client_secret.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json

# --- Limites e alertas ------------------------------------------------
MONTHLY_BUDGET_USD=50
MAX_JOB_ATTEMPTS=3
ALERT_WEBHOOK_URL=           # opcional (Slack/Discord/webhook JSON)

# --- Render -----------------------------------------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
RENDER_PRESET=veryfast
FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
